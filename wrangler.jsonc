{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shadcn-chatbot",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "upload_source_maps": true,
  "vars": {
    "CLOUDFLARE_AI_GATEWAY_ID": "shadcn-chatbot",
    // Not a credential (it's visible in dashboard URLs/API responses),
    // but still deployment configuration rather than something to
    // hard-code into executor/storage logic. Used to construct the R2
    // S3-compatible endpoint for presigned URLs (#7) and the AI Gateway
    // provider-native route (#3).
    "CLOUDFLARE_ACCOUNT_ID": "d6ad0c67765f90322b4df2ff48b582b7",
    // Mirrors r2_buckets[0].bucket_name below — kept as its own var so
    // application code never hard-codes the bucket name (#7).
    "ASSETS_BUCKET_NAME": "shadcn-chatbot-assets",
  },
  "ai": {
    "binding": "AI",
    "remote": true,
  },
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shadcn-chatbot-db",
      "database_id": "dc0ae05d-1617-4cc7-9468-5444c56a5df7",
      "migrations_dir": "./migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "shadcn-chatbot-assets",
    },
  ],
  "workflows": [
    {
      "binding": "RUNTIME_PROBE_WORKFLOW",
      "name": "shadcn-chatbot-runtime-probe",
      "class_name": "RuntimeProbeWorkflow",
      "script_name": "shadcn-chatbot-workflows",
    },
    {
      "binding": "PLAN_EXECUTION_WORKFLOW",
      "name": "shadcn-chatbot-plan-execution",
      "class_name": "PlanExecutionWorkflow",
      "script_name": "shadcn-chatbot-workflows",
    },
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
    },
  },
}
