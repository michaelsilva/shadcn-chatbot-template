{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "shadcn-chatbot-workflows",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shadcn-chatbot-db",
      "database_id": "dc0ae05d-1617-4cc7-9468-5444c56a5df7",
      "migrations_dir": "../migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "shadcn-chatbot-assets",
    },
  ],
  "workflows": [
    {
      "binding": "RUNTIME_PROBE_WORKFLOW",
      "name": "shadcn-chatbot-runtime-probe",
      "class_name": "RuntimeProbeWorkflow",
    },
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
  },
}
